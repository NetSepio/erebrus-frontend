# Copy to .env or .env.local for local development:
#   cp .env.example .env.local
#
# Public build configuration. Persistent login also requires the private runtime
# session settings below; see docs/persistent-sessions.md.

# Reown AppKit project ID — https://dashboard.reown.com
NEXT_PUBLIC_PROJECT_ID=

# Erebrus API gateway base URL (production default shown)
NEXT_PUBLIC_GATEWAY_URL=https://gateway.erebrus.io

# Helius API key — Solana NFT metadata (profile & subscribe pages)
# https://dashboard.helius.dev
NEXT_PUBLIC_HELIUS_API_KEY=

# Optional social login (both sides must be configured):
# 1) Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to your Google OAuth Web client ID
# 2) Add the same ID to gateway GOOGLE_CLIENT_IDS (comma-separated if multiple)
# 3) In Google Cloud Console → Credentials → Authorized JavaScript origins,
#    add http://localhost:3000 and your production webapp origin
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Optional: comma-separated desktop app deep-link redirect URIs for /auth.
# Defaults in code: erebrusai://auth,erebrusdrop://auth,erebrusvpn://auth
NEXT_PUBLIC_ALLOWED_DESKTOP_AUTH_REDIRECT_URIS=

# IPFS for profile images (defaults target a local Kubo daemon).
# IPFS_API_URL — node HTTP API the upload route posts to (server-side only)
# NEXT_PUBLIC_IPFS_GATEWAY_URL — public gateway base used to render images;
# switch to a hosted gateway before production.
IPFS_API_URL=
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://ipfs.erebrus.io/ipfs/

# Private SERVER runtime settings (never NEXT_PUBLIC_*; never bake into images).
# Copy these into a mode-600 .env.session on the deployment host.
# PostgreSQL direct/session-pooled connection; transaction pooling is unsupported.
SESSION_DATABASE_URL=postgresql://erebrus_sessions:REPLACE_ME@localhost:5432/erebrus_sessions
# Generate once with: openssl rand -base64 32; share across all webapp instances.
SESSION_ENCRYPTION_KEY=
# Canonical public HTTPS origin, used for CSRF verification.
APP_ORIGIN=https://erebrus.io
# Optional private gateway base; falls back to NEXT_PUBLIC_GATEWAY_URL.
GATEWAY_URL=https://gateway.erebrus.io
# Optional maximum spooled upload size (default 1 GiB).
BFF_MAX_BODY_BYTES=1073741824
